# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/local_ai_interviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=local_ai_interviewer
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Auth / JWT
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local LLM (must match a pulled model tag — see `ollama list`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Env
ENV=development
DEBUG=True
